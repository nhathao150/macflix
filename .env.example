# ====================================================
# MACFLIX - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ====================================================

# 1. MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/macflix

# 2. NextAuth Configuration
NEXTAUTH_SECRET=macflix_secret_default_key_123456
NEXTAUTH_URL=http://localhost:3000

# 3. Movie APIs
NEXT_PUBLIC_MOVIE_API_URL=https://phimapi.com
NEXT_PUBLIC_OPHIM_API_URL=https://ophim1.com

# 4. TMDB API Key (Lấy tại https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# 5. Email Configuration (Dùng cho nodemailer/contact/auth)
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# 6. Gemini API Key
GEMINI_API_KEY=
